# =============================================================================
# SenTechPLUS — Configuration Environnement Exemple (.env.example)
# Dupliquez ce fichier en '.env' et configurez vos identifiants réels.
# =============================================================================

# ─── 1. Application & Domaine Officiel ─────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_SECRET=st_sec_votre_cle_secrete_aleatoire_64_caracteres
APP_URL=https://votre-domaine.com

# ─── 2. Base de Données MySQL Hostinger (hPanel) ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_sentechplus
DB_USER=u123456789_sentech_user
DB_PASS=VotreMotDePasseHostingerSecurise!

# ─── 3. Coordonnées Officielles & Support Client Dakar ────────────────────────
CONTACT_EMAIL=contact@sentechplus.com
CONTACT_PHONE="+221 78 131 64 97"
CONTACT_ADDRESS="Point E, Boulevard de l'Est, Dakar, Sénégal"
WHATSAPP_PHONE=221781316497
WHATSAPP_DISPLAY="+221 78 131 64 97"

# ─── 4. Passerelle de Paiement Officielle PayDunya Sénégal ─────────────────────
PAYMENT_ENV=live
PAYDUNYA_MASTER_KEY=votre_master_key_paydunya
PAYDUNYA_LIVE_PRIVATE_KEY=live_private_xxxxxxxxxxxxxxxxxxxx
PAYDUNYA_LIVE_TOKEN=live_token_xxxxxxxxxxxxxxxxxxxx
PAYDUNYA_TEST_PRIVATE_KEY=test_private_xxxxxxxxxxxxxxxxxxxx
PAYDUNYA_TEST_TOKEN=test_token_xxxxxxxxxxxxxxxxxxxx

# ─── 5. Webhooks & Passerelles Locales (Wave & Orange Money) ───────────────────
WAVE_API_KEY=wave_live_pk_xxxxxxxxxxxxxxxxxxxx
WAVE_WEBHOOK_SECRET=wave_whsec_xxxxxxxxxxxxxxxxxxxx
OM_API_KEY=om_live_pk_xxxxxxxxxxxxxxxxxxxx
OM_WEBHOOK_SECRET=om_whsec_xxxxxxxxxxxxxxxxxxxx


# ─── 6. Sécurité & Sessions ───────────────────────────────────────────────────
SESSION_LIFETIME=7200
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_DECAY_MINUTES=15
MAX_UPLOAD_SIZE_MB=2
