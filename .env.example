# ─────────────────────────────────────────────────────────────────────────────
# SenTechPLUS — Variables d'environnement
# Copier ce fichier en .env.local et remplir les vraies valeurs.
# NE JAMAIS committer .env.local dans git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Frontend ────────────────────────────────────────────────────────────────

# Symbole de devise affiché dans l'interface
NEXT_PUBLIC_CURRENCY_SYMBOL=' FCFA'

# Google Analytics GA4 — laisser vide pour désactiver
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Admin ───────────────────────────────────────────────────────────────────

# Clé secrète pour protéger les routes d'administration (POST/PUT/DELETE)
# NE JAMAIS utiliser le préfixe NEXT_PUBLIC_ ici
# Générer avec : openssl rand -hex 32
ADMIN_SECRET_KEY='your-very-long-random-secret-here'

# ─── NextAuth.js v5 (Auth.js) ────────────────────────────────────────────────

# Secret JWT pour les sessions NextAuth
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET='your-nextauth-secret-here'

# URL de base de l'application (http://localhost:3000 en dev)
NEXTAUTH_URL='http://localhost:3000'

# ─── Base de données PostgreSQL (Supabase) ────────────────────────────────────

# URL de connexion poolée (pgBouncer) — pour Prisma en serverless
DATABASE_URL='postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true&connect_timeout=15'

# URL de connexion directe — pour les migrations Prisma
DIRECT_URL='postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&connect_timeout=15'

# ─── Upstash Redis (Rate Limiting) ───────────────────────────────────────────

# Créer sur console.upstash.com → REST API
UPSTASH_REDIS_REST_URL='https://your-redis-instance.upstash.io'
UPSTASH_REDIS_REST_TOKEN='your-upstash-redis-rest-token-here'
